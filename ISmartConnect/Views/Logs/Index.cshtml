@model ISmartConnect.Models.PagedResult<ISmartConnect.Entities.RequestLog>
@{
    ViewData["Title"] = "Request logs";
    var filter = (ISmartConnect.Models.LogFilterViewModel)ViewBag.Filter;
    var clientCodes = (IReadOnlyList<string>)ViewBag.ClientCodes;
}

<div class="page-header">
    <h1>Request logs</h1>
</div>

<form method="get" class="filters">
    <div class="filter-grid">
        <div>
            <label>From (UTC)</label>
            <input type="datetime-local" name="From" value="@(filter.From?.ToString("yyyy-MM-ddTHH:mm"))" />
        </div>
        <div>
            <label>To (UTC)</label>
            <input type="datetime-local" name="To" value="@(filter.To?.ToString("yyyy-MM-ddTHH:mm"))" />
        </div>
        <div>
            <label>Path</label>
            <input type="text" name="Path" value="@filter.Path" placeholder="/api/deposit/..." />
        </div>
        <div>
            <label>Client</label>
            <select name="ClientCode">
                <option value="">All</option>
                @foreach (var code in clientCodes)
                {
                    if (filter.ClientCode == code)
                    {
                        <option value="@code" selected>@code</option>
                    }
                    else
                    {
                        <option value="@code">@code</option>
                    }
                }
            </select>
        </div>
        <div>
            <label>Status</label>
            <input type="number" name="StatusCode" value="@filter.StatusCode" placeholder="200" />
        </div>
        <div>
            <label>Errors only</label>
            <select name="IsError">
                <option value="">All</option>
                @if (filter.IsError == true)
                {
                    <option value="true" selected>Errors</option>
                }
                else
                {
                    <option value="true">Errors</option>
                }
                @if (filter.IsError == false)
                {
                    <option value="false" selected>Success</option>
                }
                else
                {
                    <option value="false">Success</option>
                }
            </select>
        </div>
        <div class="span-2">
            <label>Search body / error</label>
            <input type="text" name="Search" value="@filter.Search" />
        </div>
        <div>
            <label>Sort by</label>
            <select name="SortBy">
                @SortOption("requested_at", "Time", filter.SortBy)
                @SortOption("duration_ms", "Duration", filter.SortBy)
                @SortOption("status_code", "Status", filter.SortBy)
                @SortOption("path", "Path", filter.SortBy)
                @SortOption("client_code", "Client", filter.SortBy)
                @SortOption("http_method", "Method", filter.SortBy)
            </select>
        </div>
        <div>
            <label>Direction</label>
            <select name="SortDir">
                @if (filter.SortDir == "asc")
                {
                    <option value="asc" selected>Ascending</option>
                    <option value="desc">Descending</option>
                }
                else
                {
                    <option value="asc">Ascending</option>
                    <option value="desc" selected>Descending</option>
                }
            </select>
        </div>
        <div>
            <label>Page size</label>
            <select name="PageSize">
                @PageSizeOption(10, filter.PageSize)
                @PageSizeOption(25, filter.PageSize)
                @PageSizeOption(50, filter.PageSize)
                @PageSizeOption(100, filter.PageSize)
            </select>
        </div>
    </div>
    <input type="hidden" name="Page" value="1" />
    <div class="actions">
        <button type="submit" class="btn primary">Apply</button>
        <a class="btn" href="/Logs">Reset</a>
    </div>
</form>

<p class="muted">
    @Model.TotalCount result(s)
    @if (Model.TotalPages > 0)
    {
        <text>· page @Model.Page of @Model.TotalPages</text>
    }
</p>

<div class="table-wrap">
    <table>
        <thead>
        <tr>
            <th>Time (UTC)</th>
            <th>Method</th>
            <th>Path</th>
            <th>Client</th>
            <th>Status</th>
            <th>ms</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="7" class="muted">No logs match the current filters.</td>
            </tr>
        }
        else
        {
            foreach (var log in Model.Items)
            {
                <tr class="@(log.IsError ? "row-error" : null)">
                    <td>@log.RequestedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@log.HttpMethod</td>
                    <td class="mono">@log.Path</td>
                    <td>@(log.ClientCode ?? "—")</td>
                    <td>@log.StatusCode</td>
                    <td>@log.DurationMs</td>
                    <td><a asp-action="Details" asp-route-id="@log.Id">View</a></td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <div class="pagination">
        @if (Model.Page > 1)
        {
            <a asp-action="Index"
               asp-route-Page="@(Model.Page - 1)"
               asp-route-From="@filter.From"
               asp-route-To="@filter.To"
               asp-route-Path="@filter.Path"
               asp-route-ClientCode="@filter.ClientCode"
               asp-route-StatusCode="@filter.StatusCode"
               asp-route-IsError="@filter.IsError"
               asp-route-Search="@filter.Search"
               asp-route-SortBy="@filter.SortBy"
               asp-route-SortDir="@filter.SortDir"
               asp-route-PageSize="@filter.PageSize">Prev</a>
        }
        @for (var p = 1; p <= Model.TotalPages; p++)
        {
            if (Model.TotalPages > 12 && Math.Abs(p - Model.Page) > 3 && p != 1 && p != Model.TotalPages)
            {
                if (p == 2 || p == Model.TotalPages - 1)
                {
                    <span class="muted">…</span>
                }
                continue;
            }
            <a class="@(p == Model.Page ? "active" : null)"
               asp-action="Index"
               asp-route-Page="@p"
               asp-route-From="@filter.From"
               asp-route-To="@filter.To"
               asp-route-Path="@filter.Path"
               asp-route-ClientCode="@filter.ClientCode"
               asp-route-StatusCode="@filter.StatusCode"
               asp-route-IsError="@filter.IsError"
               asp-route-Search="@filter.Search"
               asp-route-SortBy="@filter.SortBy"
               asp-route-SortDir="@filter.SortDir"
               asp-route-PageSize="@filter.PageSize">@p</a>
        }
        @if (Model.Page < Model.TotalPages)
        {
            <a asp-action="Index"
               asp-route-Page="@(Model.Page + 1)"
               asp-route-From="@filter.From"
               asp-route-To="@filter.To"
               asp-route-Path="@filter.Path"
               asp-route-ClientCode="@filter.ClientCode"
               asp-route-StatusCode="@filter.StatusCode"
               asp-route-IsError="@filter.IsError"
               asp-route-Search="@filter.Search"
               asp-route-SortBy="@filter.SortBy"
               asp-route-SortDir="@filter.SortDir"
               asp-route-PageSize="@filter.PageSize">Next</a>
        }
    </div>
}

@functions {
    private static Microsoft.AspNetCore.Html.IHtmlContent SortOption(string value, string label, string current)
    {
        var selected = string.Equals(value, current, StringComparison.OrdinalIgnoreCase) ? " selected" : "";
        return new Microsoft.AspNetCore.Html.HtmlString($"<option value=\"{value}\"{selected}>{label}</option>");
    }

    private static Microsoft.AspNetCore.Html.IHtmlContent PageSizeOption(int value, int current)
    {
        var selected = value == current ? " selected" : "";
        return new Microsoft.AspNetCore.Html.HtmlString($"<option value=\"{value}\"{selected}>{value}</option>");
    }
}
